pipeline {
  agent any

  stages {
    stage('Build image') {
      steps {
        script {
          docker.build(
            "sanity-python:${BUILD_NUMBER}",
            "."
          )
        }
      }
    }

    stage('Run script') {
      steps {
        script {
          docker.image("sanity-python:${BUILD_NUMBER}").inside {
            sh 'python brain/sli_ver11.py'
          }
        }
      }
    }
  }
}
